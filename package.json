  "keywords": ["magpie", "magpie-agent", "yuri", "opencode"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yee94/magpie-agent-yuri.git"
  },
  "magpie": {
    "name": "Yuri",
    "summary": {
      "en": "Connect Yuri's shared OpenCode V2 service to Magpie. Keeps existing plugins and options; choose models in Yuri. Also affects a CLI sharing that service.",
      "zh": "把 Yuri 共用的 OpenCode V2 服务接入 Magpie，保留已有插件和选项；在 Yuri 中选择模型，也会影响共用服务的 CLI。"
