  "main": "./index.mjs",
  "files": ["index.mjs", "yuri.agent.js", "bridge.mjs", "vendor.mjs", "provider", "assets", "README.md", "VERIFICATION.md", "verification", "THIRD_PARTY.md", "ASSET_NOTICE.md", "LICENSE", "LICENSE-YURI", "LICENSE-JSONC-PARSER"],
